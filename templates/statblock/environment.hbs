<section class="tab cosmo-sb-page {{tabs.statblock.cssClass}}" data-tab="statblock" data-group="primary">
    <div class="cosmo-sb-card">
        {{> cosmo-sb-header}}
        <section class="cosmo-sb-stats">
            <div class="cosmo-sb-row">
                <span><strong>{{localize "DAGGERHEART.GENERAL.difficulty"}}:</strong> {{sb.difficulty}}</span>
            </div>
            <div class="cosmo-sb-row cosmo-sb-adversaries">
                <span>
                    <strong>{{localize "DAGGERHEART.ACTORS.Environment.Embed.potentialAdversaries"}}:</strong>
                    {{#each sb.adversaryGroups as |group|}}
                        {{group.label}}{{#if group.adversaries.length}} ({{#each group.adversaries as |adv|}}<a class="cosmo-sb-adversary" data-action="openStatblockActor" data-uuid="{{adv.uuid}}">{{adv.name}}</a>{{#unless adv.last}}, {{/unless}}{{/each}}){{/if}}{{#unless group.last}},{{/unless}}
                    {{else}}
                        {{localize "DAGGERHEART.ACTORS.Environment.Embed.any"}}
                    {{/each}}
                </span>
            </div>
        </section>
        {{> cosmo-sb-features features=sb.features}}
    </div>
</section>
