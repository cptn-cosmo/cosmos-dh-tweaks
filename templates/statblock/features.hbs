{{#*inline "cosmo-sb-feature"}}
<li class="inventory-item cosmo-sb-feature{{#if inactive}} inactive{{/if}}" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}"
    data-type="feature" data-item-type="{{item.type}}" {{#if inactive}}data-disabled="true"{{/if}}>
    <span class="cosmo-sb-feature-head{{#if item.hasDescription}} toggle{{/if}}" {{#if item.hasDescription}}data-action="toggleExtended"{{/if}}>
        <strong class="cosmo-sb-feature-name">{{item.name}}{{#if form}} - {{form}}{{/if}}:</strong>
    </span>
    {{#if item.system.resource}}
        <span class="cosmo-sb-resource">{{> "systems/daggerheart/templates/sheets/global/partials/item-resource.hbs" item=item}}</span>
    {{/if}}
    <div class="inventory-item-content extensible"><div class="inventory-description"></div></div>
    {{#if actions.length}}
        <div class="cosmo-sb-actions">
            {{#each actions as |action|}}
                <span class="item-button cosmo-sb-action">
                    <button type="button" data-action="useItem" data-item-uuid="{{action.uuid}}" {{#if ../inactive}}disabled{{/if}}>{{action.name}}</button>
                    {{#if action.uses}}<button type="button" class="action-uses-button" data-action="increaseActionUses" data-item-uuid="{{action.uuid}}" {{#if ../inactive}}disabled{{/if}}>{{action.uses}}</button>{{/if}}
                </span>
            {{/each}}
        </div>
    {{/if}}
</li>
{{/inline}}
<section class="cosmo-sb-features">
    <h2 class="cosmo-sb-features-heading">{{localize "DAGGERHEART.GENERAL.features"}}</h2>
    <ul class="cosmo-sb-feature-list">
        {{#each features}}{{> cosmo-sb-feature}}{{/each}}
    </ul>
    {{#if evolution.length}}
        <ul class="cosmo-sb-feature-list evolution">
            {{#each evolution}}{{> cosmo-sb-feature}}{{/each}}
        </ul>
    {{/if}}
</section>
